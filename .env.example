# localhost only works in a web browser or simulator/emulator running on this
# same machine. On a physical phone (e.g. via Expo Go), "localhost" resolves
# to the phone itself, not this computer — use your computer's LAN IP instead,
# e.g. http://192.168.1.23:4000/api. Find it with `ipconfig getifaddr en0`
# (Mac Wi-Fi) or `ipconfig` (Windows). Phone and computer must be on the same
# network, and the API server must be reachable on that IP (not just
# localhost) — see DEPLOYMENT.md.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
